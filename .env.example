# Foley Books — required environment variables (copy to .env; .env is gitignored).
# Placeholders only — never commit real secrets.

# --- Eureka registry security (ADR-006) -----------------------------------
# Server-side Basic auth credentials for discovery-service (required; startup
# fails without them).
EUREKA_SECURITY_USERNAME=change-me-registry-user
EUREKA_SECURITY_PASSWORD=change…word
# Client credentials used by api-gateway / auth / catalog / order to register
# with the registry. MUST match EUREKA_SECURITY_* above.
EUREKA_USERNAME=change-me-registry-user
EUREKA_PASSWORD=change…word
# Host/name clients use to reach the registry: discovery-service inside the
# compose network, localhost for services running on the host.
EUREKA_HOSTNAME=discovery-service

# --- Frontend ---------------------------------------------------------------
# Used by the gateway CORS config and by auth-service for confirmation links
# (D-01). In production this becomes the deployed frontend URL.
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT (AGENTS.md §5) -------------------------------------------------------
# JWKS URI consumed by catalog-service and order-service (resource servers).
JWKS_URI=http://auth-service:8081/oauth2/jwks
# Production only — dev auto-generates the RSA keypair at startup. Provide PEM
# values here for non-dev deployments (uncomment and set):
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# --- Databases (one user + database + volume per service, C18) ---------------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change…-me-03

# --- SMTP (auth-service mail, D-02) ------------------------------------------
# Defaults point at the Mailpit dev container; UI at http://localhost:8025.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
# Envelope sender for confirmation / already-registered emails; feeds the
# app-owned app.mail.from knob (ADR-001) — Boot has no spring.mail.from.
# Override for a real provider at production time.
SPRING_MAIL_FROM=noreply@foleybooks.com
